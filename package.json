{
  "name": "orderflow",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do OrderFlow com backend Fastify, frontend React/Vite e MariaDB.",
  "scripts": {
    "dev": "sh -c 'npm run dev:backend & npm run dev:frontend & wait'",
    "start": "npm run dev",
    "dev:backend": "cd backend && tsx watch src/server.ts",
    "dev:frontend": "cd frontend && vite",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && tsc -p tsconfig.json",
    "build:frontend": "cd frontend && tsc -b && vite build",
    "lint": "cd frontend && oxlint",
    "lint:backend": "cd backend && tsc -p tsconfig.tests.json && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "npm run test:backend && npm run test:frontend",
    "test:db": "cd backend && RUN_TABLES_DB_TESTS=1 node --test-force-exit --import tsx --test tests/tables.integration.test.ts",
    "install:all": "npm ci",
    "setup": "npm run install:all && npm run prisma:generate",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f database",
    "prisma:generate": "cd backend && prisma generate",
    "prisma:migrate": "cd backend && prisma migrate dev",
    "start:backend": "cd backend && node dist/server.js",
    "test:backend": "cd backend && node --test-force-exit --import tsx --test tests/*.test.ts",
    "test:unit": "cd backend && node --test-force-exit --import tsx --test tests/*.test.ts",
    "typecheck": "cd backend && tsc -p tsconfig.tests.json",
    "format": "cd backend && prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "cd backend && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "preview": "cd frontend && vite preview",
    "test:frontend": "cd frontend && node --test tests/*.test.mjs",
    "check:backend": "npm run lint:backend && npm run test:backend"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^4.6.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.15.0"
  },
  "overrides": {
    "glob": "^14.0.2"
  },
  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "typescript": "~6.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sass": "^1.106.1",
    "sass-embedded": "^1.106.1",
    "vite": "~8.2.4"
  }
}
