# Copy to a private file and pass it with: docker compose --env-file production.env -f docker-compose.production.yml up --build -d

# Never publish with the sample credentials. URL-encode reserved characters in DATABASE_URL's password.

MARIADB_ROOT_PASSWORD=replace-with-a-long-random-password


MARIADB_PASSWORD=replace-with-another-long-random-password

DATABASE_URL=mysql://mesaflow:replace-with-another-long-random-password@database:3306/mesaflow
JWT_SECRET=replace-with-a-long-random-secret

# Use the exact public origin, without a trailing slash; use http://localhost for local verification.
FRONTEND_URL=http://localhost
