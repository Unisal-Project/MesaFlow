# ── Desenvolvimento | backend executado no host ──
PORT=3333
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://orderflow:orderflow@127.0.0.1:3307/orderflow
JWT_SECRET=development-only-change-me
# Opcional. No host, o Valkey do Compose não publica uma porta.
VALKEY_URL=

# ── Desenvolvimento | rede interna do Docker Compose ──
DEV_MARIADB_ROOT_PASSWORD=root
DEV_MARIADB_PASSWORD=orderflow
DEV_DATABASE_URL=mysql://orderflow:orderflow@database:3306/orderflow
DEV_VALKEY_URL=redis://valkey:6379
CHOKIDAR_USEPOLLING=

# ── Frontend | valores públicos ──
# Vazio usa o host da página, porta 3333 e prefixo /api/v1.
VITE_API_URL=
# Vazio usa o host da página e porta 9101.
VITE_PRINT_URL=

# ── Staging | preencha antes de subir o ambiente ──
STAGING_MARIADB_ROOT_PASSWORD=
STAGING_MARIADB_PASSWORD=
# mysql://mesaflow:<senha-codificada>@database:3306/mesaflow
STAGING_DATABASE_URL=
STAGING_JWT_SECRET=
STAGING_FRONTEND_URL=http://127.0.0.1:8080
STAGING_VALKEY_URL=redis://valkey:6379

# ── Produção | preencha antes de subir o ambiente ──
PRODUCTION_MARIADB_ROOT_PASSWORD=
PRODUCTION_MARIADB_PASSWORD=
# mysql://mesaflow:<senha-codificada>@database:3306/mesaflow
PRODUCTION_DATABASE_URL=
PRODUCTION_JWT_SECRET=
PRODUCTION_FRONTEND_URL=
PRODUCTION_VALKEY_URL=redis://valkey:6379

# ── Testes | MariaDB temporário em 127.0.0.1:3308 ──
TEST_MARIADB_ROOT_PASSWORD=root_test
TEST_MARIADB_PASSWORD=mesaflow_test

# ── Push | uso futuro, somente no backend ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
